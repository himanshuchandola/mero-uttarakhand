# Public playlist URL (the API extracts its list= ID), or a single video URL (extracts its v= ID).
# The header link points here too.
NEXT_PUBLIC_YOUTUBE_PLAYLIST_URL=https://www.youtube.com/playlist?list=YOUR_PLAYLIST_ID

# Public Spotify playlist URL, linked from the "Spotify" chip in the header.
# Falls back to https://open.spotify.com if left unset.
NEXT_PUBLIC_SPOTIFY_PLAYLIST_URL=https://open.spotify.com/playlist/YOUR_PLAYLIST_ID

# Server-only YouTube Data API v3 key. Restrict it to the YouTube Data API in Google Cloud.
YOUTUBE_DATA_API_KEY=your-youtube-data-api-key

# Optional. Canonical origin, used to resolve absolute Open Graph URLs.
# Leave unset on Vercel — the production URL is picked up automatically.
# NEXT_PUBLIC_SITE_URL=https://mero-uttarakhand.app

# Optional. Public GitHub repo URL — shows a "GitHub" chip in the header when set.
# Leave unset until the repo is actually pushed and public.
# NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/your-username/mero-uttarakhand
